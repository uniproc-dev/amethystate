---
import { asset } from '../utils/asset';
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href={asset('/favicon.svg')} />
  <link rel="icon" href={asset('/favicon.ico')} />
  <meta name="generator" content={Astro.generator} />
  <meta name="description" content="State for Rust apps that persists itself — no serialization layer, no hand-written migrations." />
  <title>amethystate</title>
  <link rel="preconnect" href="https://api.fontshare.com" />
  <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />
  <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=clash-display@600,700&f[]=jetbrains-mono@400,500&display=swap" />
</head>
<body>

<div id="page">
  <div class="main">
    <div class="copy" data-crystal="copy">
      <h1>AMETHYSTATE</h1>
      <p class="lede">
        State for Rust apps that persists itself. No serialization layer,
        no hand-written migrations.
      </p>
      <div class="inst"><b>$</b> cargo add amethystate</div>
      <div class="cta">
        <a class="p" href={asset('/getting-started/installation/')}>Get started</a>
        <a class="g" href="https://github.com/Tam1SH/amethystate">GitHub</a>
      </div>
    </div>
  </div>

  <div class="foot">
    <span>amethystate · MIT</span>
    <span>
      <a href={asset('/getting-started/quick-start/')}>Quick start</a>
      <a href={asset('/integrations/overview/')}>Integrations</a>
      <a href={asset('/migrations/overview/')}>Migrations</a>
      <a href="https://github.com/Tam1SH/amethystate">GitHub</a>
    </span>
  </div>
</div>

<script>
  import { mountCrystals } from '../scripts/crystal.js';

  const CRYSTAL = {
    plateauPad: 56, spread: 0.14, apron: 60, rampFactor: 1.5,
    depth: 150, flatTilt: 5, hue: 266, floor: 7,
    flatHueJitter: 5, flatSatJitter: 5,
    matrix: true, animateIn: 1600, easing: 'inOut', stagger: 0.5,
  };

  let report: ((shards: { faces: number }[]) => void) | undefined;

  const handle = mountCrystals({
    container: document.getElementById('page'),
    groups: ['[data-crystal="copy"]'],
    ...CRYSTAL,
    onDone: shards => report?.(shards),
  });

  if (import.meta.env.DEV) {
    const { mountControls } = await import('../scripts/crystal-controls.js');
    report = mountControls(handle, CRYSTAL).report;
    handle.redraw();
  }
</script>

<style is:global>
  * { box-sizing: border-box }
  html, body { height: 100% }
  body {
    margin: 0;
    background: #080510;
    color: #efe9f6;
    overflow: hidden;
    font: 16px/1.6 system-ui, -apple-system, sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  @media (max-height: 620px), (max-width: 560px) {
    body { overflow: auto }
    #page { height: auto; min-height: 100% }
  }

  #page {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    padding: clamp(28px, 4vh, 52px) clamp(24px, 4vw, 64px);
  }

  .main {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    z-index: 2;
  }

  .copy { max-width: 30rem }

  h1 {
    font: 700 clamp(38px, 6vw, 84px)/.94 'Clash Display', system-ui, sans-serif;
    letter-spacing: .02em;
    margin: 0 0 clamp(12px, 1.8vh, 20px);
  }
  .lede {
    font-size: clamp(15px, 1.4vw, 19px);
    color: #d5cbe6;
    margin: 0 0 clamp(16px, 2.4vh, 26px);
  }
  .inst {
    font: 14px 'JetBrains Mono', monospace;
    display: inline-flex;
    gap: 10px;
    background: rgba(6, 4, 12, .78);
    border: 1px solid #3d2f57;
    padding: 11px 17px;
    margin-bottom: clamp(14px, 2vh, 22px);
  }
  .inst b { color: #8d7fae; font-weight: 400 }

  .cta { display: flex; gap: 11px; flex-wrap: wrap }
  .cta a { font-size: 14px; font-weight: 500; text-decoration: none; padding: 11px 22px }
  .cta .p { background: #b08ad8; color: #160f22 }
  .cta .g { background: rgba(8, 5, 16, .6); color: #e4dcf0; border: 1px solid #4b3a69 }

  .foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    position: relative;
    z-index: 2;
    font: 12px 'JetBrains Mono', monospace;
    color: #6b5f82;
    padding-top: 18px;
  }
  .foot a { color: #a08fc4; text-decoration: none; margin-left: 20px }
  .foot a:hover { color: #e4dcf0 }
</style>
</body>
</html>
