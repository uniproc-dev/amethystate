{
  "name": "amethystate",
  "version": "0.5.0",
  "description": "Reactive persistent state for Tauri apps",
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "homepage": "https://guinea-rs.github.io/amethystate/integrations/typescript/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guinea-rs/amethystate.git"
  },
  "bugs": {
    "url": "https://github.com/guinea-rs/amethystate/issues"
  },
  "keywords": [
    "tauri",
    "state",
    "reactive",
    "persistent",
    "store"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run check && npm test && npm run build"
  },
  "peerDependencies": {
    "@tauri-apps/api": ">=2.0"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2",
    "happy-dom": "^20.14.5",
    "typescript": "^7.0.2",
    "vitest": "^5"
  }
}
